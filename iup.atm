;; An environment for graphical user interfaces, over IUP.
;;
;;      atmos-iup prog.atm              ;; the dedicated compiler (`make`)
;;
;;      include "iup.atm"               ;; or with the plain compiler
;;
;; The binding is thin and generic, as the C interface of IUP itself:
;;
;;      iup.new(class, t)       a control of the given class (`:button`,
;;                              `:text`, `:hbox`, `:dialog`, ...): the named
;;                              fields of `t` are its attributes, and the
;;                              positional ones are its children
;;      iup.set(h, name, v)     sets an attribute
;;      iup.get(h, name)        reads an attribute, as a string or nil
;;      iup.show(h)             shows a dialog
;;      iup.hide(h)             hides a dialog
;;      iup.popup(h, x, y)      shows a menu or a dialog, and holds the other
;;                              dialogs until it closes
;;      iup.update(h)           asks a control to be drawn again
;;      iup.draw(h, op, ...)    draws on a canvas
;;
;; The names of the attributes are those of IUP, in any case
;; (`title="Count"` is `TITLE`). A value is a string, a number, or a
;; boolean (`"YES"` and `"NO"`). A `nil` gives the attribute its default
;; back.
;;
;; The program runs inside the loop of IUP, which emits the callbacks of
;; the controls as events, each with the handle of its control:
;;
;;      :action [h]             `ACTION` (a button was pressed, a canvas
;;                              must be drawn, ...); for a list,
;;                              `:action [h,text,item,state]`, an item that
;;                              was selected or unselected (from 1)
;;      :value  [h]             `VALUECHANGED_CB` (a text was edited, ...)
;;      :close  [h]             `CLOSE_CB` (a dialog was closed)
;;      :button [h,but,press,x,y,status]
;;                              `BUTTON_CB` (a button of the mouse, `1` to
;;                              `3`, was pressed or released on a canvas)
;;      :motion [h,x,y,status]  `MOTION_CB` (the mouse moved on a canvas)
;;      :key    [h,code,char]   `K_ANY` (a key was pressed in a control: its
;;                              code in IUP, `K_*` of iupkey.h, and the
;;                              character if it is printable)
;;      :focus  [h,focus]       `GETFOCUS_CB` and `KILLFOCUS_CB` (a control
;;                              got or lost the focus of the keyboard)
;;      :popup  [h]             a popup was closed
;;
;; An event is emitted inside its callback, so the program reacts before
;; IUP goes on: a canvas is drawn in the reaction to its `:action`. An
;; event that happens while the program reacts (it called a function of
;; IUP that called a callback) waits for the reaction to end.
;;
;; What a callback returns to IUP is set before it happens, in an
;; attribute of the control with the name of the callback and the prefix
;; `ATM_`: `iup.set(dlg, "ATM_CLOSE_CB", "IGNORE")` refuses to close a
;; dialog. The values are `DEFAULT` (when not set), `IGNORE`,
;; `CONTINUE`, and `CLOSE`. As any attribute of IUP, a control that does
;; not have it takes it from its parent.
;;
;; A popup of IUP only returns when it is closed. So `iup.popup` does
;; not show it at once, but when the program ends its reaction, and the
;; event `:popup` tells that it was closed.
;;
;; The operations of `iup.draw` are those of `IupDraw` (the color and the
;; style are the attributes `DRAWCOLOR`, `DRAWSTYLE`, ... of the canvas):
;;
;;      iup.draw(h, :begin)     iup.draw(h, :end)
;;      iup.draw(h, :line, x1, y1, x2, y2)
;;      iup.draw(h, :rectangle, x1, y1, x2, y2)
;;      iup.draw(h, :arc, x1, y1, x2, y2 [, a1, a2])
;;      iup.draw(h, :text, str, x, y)
;;
;; The environment registers itself with `atmos.env`, in either mode. As
;; the primary environment (the first one included), it waits in the loop
;; of IUP and gives the time to the program. As a secondary one, it only
;; processes what IUP has ready, and the time comes from the primary. A
;; program may include another environment after this one, such as
;; `uv.atm` of `ia-atmos/env-uv` (the network): each step of IUP is then
;; followed by a step of the other.
;;
;; Time passes inside the loop, so that `await 1s` works as usual. The
;; program terminates when its main chunk does, not when the last dialog
;; is closed.
;;
;; A handle is a native value, declared with `pin`. A control that has
;; no parent is destroyed when its handle is released, and a dialog
;; destroys its controls.
;;
;; To test with no person (under `xvfb-run`), `IUP_ATM_SCRIPT` holds a
;; list of actions at given times, in milliseconds, separated by `;`.
;; The time is then virtual, in steps of 10ms. A control is given by its
;; attribute `HANDLENAME`, the global name of IUP (`IupSetHandle`):
;;
;;      ms:click:name[:x,y]     presses and releases the left button of the
;;                              mouse on a control (at its center, or at a
;;                              position inside it)
;;      ms:dclick:name[:x,y]    a double click of the left button
;;      ms:rclick:name[:x,y]    the same with the right button
;;      ms:move:name[:x,y]      moves the mouse
;;      ms:set:name:ATTR=value  sets an attribute, as if the user did it
;;                              (the `VALUECHANGED_CB` is called)
;;      ms:get:name:ATTR        prints an attribute, as `name.ATTR = value`
;;      ms:key:name:c           gives the focus to a control and presses a
;;                              key: a character, or a code (`0xFF1B`)
;;      ms:act:name             chooses an item of a menu (its `ACTION` is
;;                              called, and the menu is closed)
;;      ms:close:name           closes a dialog (the `CLOSE_CB` is called)
;;      ms:shot:file.png        saves the screen (needs `import`)
;;
;; The clicks and the moves are real events of X, through the extension
;; XTest of the server (`Xvfb` has it), if `libXtst` is there; else they
;; are the events that IUP synthesizes, which a menu of GTK ignores.
;;      ms:quit                 terminates the program

```:prelude
#define _GNU_SOURCE
#include <dlfcn.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>
#include <time.h>
#include <unistd.h>
#include <iup.h>
#include <iupdraw.h>
#include <iupkey.h>

static const char* ATI_KIND = "iup.handle";

// The slot of a control that points back to its native value. It is
// not a reference: the value clears it when it is released. It is kept
// as a callback, and not as an attribute, since a control inherits the
// attributes that it does not have from its parent.
#define ATI_NAT "_ATM_NAT"

static ANat* ati_nat_get (Ihandle* h) {
    return (ANat*) IupGetCallback(h, ATI_NAT);
}

static void ati_nat_set (Ihandle* h, ANat* nat) {
    IupSetCallback(h, ATI_NAT, (Icallback) nat);
}

// The state of the driver.
static AStatus ATI_ST   = A_OK;     // the status of the program
static int     ATI_BUSY = 0;        // the program is reacting
static int     ATI_QUIT = 0;        // the script asked to terminate
static int     ATI_POPS = 0;        // the popups in course
static int     ATI_TICK = 0;        // the timer of the time is running

// The events that happen while the program is reacting (it called a
// function of IUP that called a callback): they wait for it.
#define ATI_QUEUE_MAX 256
static AVal ATI_QUEUE[ATI_QUEUE_MAX];
static int  ATI_QUEUE_N = 0;

// Emits an event to the program. The event is not consumed.
static void ati_emit (AVal evt) {
    if (ATI_ST==A_OK && atm_alive()) {
        ATI_BUSY++;
        ATI_ST = atm_emit(evt);
        ATI_BUSY--;
    }
}

static void ati_drain (void) {
    for (int i=0; i<ATI_QUEUE_N; i++) {
        ati_emit(ATI_QUEUE[i]);
        a_dec(ATI_QUEUE[i]);
    }
    ATI_QUEUE_N = 0;
}

// Leaves the loop of IUP when the program is over.
static void ati_check (void) {
    if ((ATI_ST!=A_OK || ATI_QUIT || !atm_alive()) && IupMainLoopLevel()>0) {
        IupExitLoop();
    }
}

// An event of IUP (consumed): emitted at once, or kept in the queue.
static void ati_fire (AVal evt) {
    if (ATI_BUSY) {
        if (ATI_QUEUE_N < ATI_QUEUE_MAX) {
            ATI_QUEUE[ATI_QUEUE_N++] = evt;
        } else {
            a_dec(evt);
        }
    } else {
        ati_emit(evt);
        a_dec(evt);
        ati_drain();
        ati_check();
    }
}

// A control was destroyed by IUP (with its dialog): its native value,
// if any, no longer has what to destroy.
static int ati_destroy_cb (Ihandle* h) {
    ANat* nat = ati_nat_get(h);
    if (nat != NULL) {
        nat->ptr = NULL;
    }
    return IUP_DEFAULT;
}

// The finalizer of a handle: destroys the control, unless it belongs to
// a parent, which destroys it.
static void ati_fin (void* ptr) {
    Ihandle* h = ptr;
    ati_nat_set(h, NULL);
    if (IupGetParent(h) == NULL) {
        IupDestroy(h);
    }
}

// The native value of a control (owned): the one the program holds, or
// a new one.
static AVal ati_nat (Ihandle* h) {
    ANat* nat = ati_nat_get(h);
    if (nat != NULL) {
        AVal v = a_obj(&nat->hdr);
        a_inc(v);
        return v;
    }
    AVal v = a_nat(h, ati_fin, ATI_KIND);
    ati_nat_set(h, A_NAT_OF(v));
    return v;
}

// The control of a handle, or NULL.
static Ihandle* ati_ptr (AVal v) {
    return a_nat_is(v, ATI_KIND) ? a_nat_ptr(v) : NULL;
}

// Sets a field of an event (the value is consumed). The event is being
// born: it may hold a pinned handle, and cannot leave its block.
static void ati_fld (AVal evt, const char* k, AVal v) {
    AVal key = a_strz(k);
    if (a_tab_field(evt, key, v) != A_OK) {
        fprintf(stderr, "iup : invalid field of an event : %s\n", k);
    }
    a_dec(key);
    a_dec(v);
}

// A new event `:tag [h=handle]`.
static AVal ati_evt (const char* tag, Ihandle* h) {
    AVal evt = a_tab();
    AVal t = a_strz(tag);
    a_tag(evt, t);
    a_dec(t);
    ati_fld(evt, "h", ati_nat(h));
    return evt;
}

// What a callback returns: the attribute `ATM_<callback>`.
static int ati_ret (Ihandle* h, const char* cb) {
    char name[64];
    snprintf(name, sizeof(name), "ATM_%s", cb);
    const char* ret = IupGetAttribute(h, name);
    if (ret == NULL) {
        return IUP_DEFAULT;
    } else if (!strcmp(ret, "IGNORE")) {
        return IUP_IGNORE;
    } else if (!strcmp(ret, "CONTINUE")) {
        return IUP_CONTINUE;
    } else if (!strcmp(ret, "CLOSE")) {
        return IUP_CLOSE;
    }
    return IUP_DEFAULT;
}

// The callbacks that become events: one function for each, since IUP
// does not tell which one it calls. The first three ignore the other
// arguments of their callbacks.

static int ati_cb_action (Ihandle* h) {
    int ret = ati_ret(h, "ACTION");
    ati_fire(ati_evt("action", h));
    return ret;
}

static int ati_cb_value (Ihandle* h) {
    int ret = ati_ret(h, "VALUECHANGED_CB");
    ati_fire(ati_evt("value", h));
    return ret;
}

static int ati_cb_close (Ihandle* h) {
    int ret = ati_ret(h, "CLOSE_CB");
    ati_fire(ati_evt("close", h));
    return ret;
}

static int ati_cb_button (Ihandle* h, int but, int press, int x, int y, char* status) {
    AVal evt = ati_evt("button", h);
    ati_fld(evt, "but",    a_int(but - '0'));
    ati_fld(evt, "press",  a_bool(press));
    ati_fld(evt, "x",      a_int(x));
    ati_fld(evt, "y",      a_int(y));
    ati_fld(evt, "status", a_strz(status));
    int ret = ati_ret(h, "BUTTON_CB");
    ati_fire(evt);
    return ret;
}

static int ati_cb_motion (Ihandle* h, int x, int y, char* status) {
    AVal evt = ati_evt("motion", h);
    ati_fld(evt, "x",      a_int(x));
    ati_fld(evt, "y",      a_int(y));
    ati_fld(evt, "status", a_strz(status));
    int ret = ati_ret(h, "MOTION_CB");
    ati_fire(evt);
    return ret;
}

static int ati_focus (Ihandle* h, int focus, const char* cb) {
    AVal evt = ati_evt("focus", h);
    ati_fld(evt, "focus", a_bool(focus));
    int ret = ati_ret(h, cb);
    ati_fire(evt);
    return ret;
}

static int ati_cb_getfocus (Ihandle* h) {
    return ati_focus(h, 1, "GETFOCUS_CB");
}

static int ati_cb_killfocus (Ihandle* h) {
    return ati_focus(h, 0, "KILLFOCUS_CB");
}

// A key: its code in IUP (`K_*` of iupkey.h), and the character if it
// is printable.
static int ati_cb_key (Ihandle* h, int c) {
    AVal evt = ati_evt("key", h);
    ati_fld(evt, "code", a_int(c));
    if (iup_isprint(c)) {
        char s[2] = { (char)c, '\0' };
        ati_fld(evt, "char", a_strz(s));
    }
    int ret = ati_ret(h, "K_ANY");
    ati_fire(evt);
    return ret;
}

// The `ACTION` of a list has the item: an item that is selected or
// unselected (1 from the first).
static int ati_cb_list (Ihandle* h, char* text, int item, int state) {
    AVal evt = ati_evt("action", h);
    ati_fld(evt, "text",  a_strz(text));
    ati_fld(evt, "item",  a_int(item));
    ati_fld(evt, "state", a_bool(state));
    int ret = ati_ret(h, "ACTION");
    ati_fire(evt);
    return ret;
}

static const struct { const char* cb; Icallback f; } ATI_CBS[] = {
    { "ACTION",          (Icallback) ati_cb_action },
    { "VALUECHANGED_CB", (Icallback) ati_cb_value  },
    { "CLOSE_CB",        (Icallback) ati_cb_close  },
    { "BUTTON_CB",       (Icallback) ati_cb_button },
    { "MOTION_CB",       (Icallback) ati_cb_motion },
    { "GETFOCUS_CB",     (Icallback) ati_cb_getfocus  },
    { "KILLFOCUS_CB",    (Icallback) ati_cb_killfocus },
    { "K_ANY",           (Icallback) ati_cb_key       },
};
#define ATI_CBS_N ((int)(sizeof(ATI_CBS)/sizeof(ATI_CBS[0])))

// The name of an attribute, in upper case.
static void ati_name (char* dst, size_t n, const char* src) {
    size_t i = 0;
    for (; i+1<n && src[i]!='\0'; i++) {
        dst[i] = toupper((unsigned char) src[i]);
    }
    dst[i] = '\0';
}

static AStatus ati_set (AVal h, AVal k, AVal v) {
    Ihandle* ih = ati_ptr(h);
    if (ih == NULL) {
        return a_error("invalid handle");
    }
    if (k.type != A_STR) {
        return a_error("invalid attribute : expected string");
    }
    char name[128];
    ati_name(name, sizeof(name), A_STR_OF(k)->s);
    if (v.type == A_NIL) {
        IupSetAttribute(ih, name, NULL);
    } else if (v.type == A_BOOL) {
        IupSetAttribute(ih, name, a_truthy(v) ? "YES" : "NO");
    } else if (v.type==A_STR || a_isnum(v)) {
        AVal s = a_tostring(v);
        if (!strcmp(name, "HANDLENAME")) {
            IupSetHandle(A_STR_OF(s)->s, ih);
        } else {
            IupSetStrAttribute(ih, name, A_STR_OF(s)->s);
        }
        a_dec(s);
    } else {
        return a_error("invalid value : attribute %s", name);
    }
    return A_OK;
}

static AStatus ati_get (AVal* dst, AVal h, AVal k) {
    Ihandle* ih = ati_ptr(h);
    if (ih == NULL) {
        return a_error("invalid handle");
    }
    if (k.type != A_STR) {
        return a_error("invalid attribute : expected string");
    }
    char name[128];
    ati_name(name, sizeof(name), A_STR_OF(k)->s);
    const char* v = IupGetAttribute(ih, name);
    *dst = (v == NULL) ? a_nil() : a_strz(v);
    return A_OK;
}

static AStatus ati_new (AVal* dst, AVal cls, AVal t) {
    if (cls.type != A_STR) {
        return a_error("invalid class : expected string");
    }
    if (t.type!=A_NIL && t.type!=A_TAB) {
        return a_error("invalid attributes : expected table");
    }
    Ihandle* ih = IupCreate(A_STR_OF(cls)->s);
    if (ih == NULL) {
        return a_error("invalid class : %s", A_STR_OF(cls)->s);
    }
    AVal h = ati_nat(ih);
    IupSetCallback(ih, "DESTROY_CB", ati_destroy_cb);
    for (int i=0; i<ATI_CBS_N; i++) {
        IupSetCallback(ih, ATI_CBS[i].cb, ATI_CBS[i].f);
    }
    if (!strcmp(IupGetClassName(ih), "list")) {
        IupSetCallback(ih, "ACTION", (Icallback) ati_cb_list);
    }
    AStatus st = A_OK;
    if (t.type == A_TAB) {
        // the children, in order
        for (AInt i=0; st==A_OK; i++) {
            AVal c = a_tab_get(A_TAB_OF(t), a_int(i));
            if (c.type == A_NIL) {
                break;
            }
            Ihandle* ic = ati_ptr(c);
            if (ic == NULL) {
                st = a_error("invalid child : expected handle");
            } else if (IupGetParent(ic) != NULL) {
                st = a_error("invalid child : it has a parent");
            } else if (IupAppend(ih, ic) == NULL) {
                st = a_error("invalid child : %s is not a container",
                    A_STR_OF(cls)->s);
            }
        }
        // the attributes
        uint32_t pos = 0;
        AVal k, v;
        while (st==A_OK && a_tab_next(A_TAB_OF(t), &pos, &k, &v)) {
            if (k.type == A_STR) {
                st = ati_set(h, k, v);
            }
        }
    }
    if (st != A_OK) {
        a_dec(h);
        return st;
    }
    *dst = h;
    return A_OK;
}

static AStatus ati_show (AVal h, int show) {
    Ihandle* ih = ati_ptr(h);
    if (ih == NULL) {
        return a_error("invalid handle");
    }
    if (show) {
        IupShow(ih);
    } else {
        IupHide(ih);
    }
    return A_OK;
}

static AStatus ati_update (AVal h) {
    Ihandle* ih = ati_ptr(h);
    if (ih == NULL) {
        return a_error("invalid handle");
    }
    IupUpdate(ih);
    return A_OK;
}

// The popups that wait for the program to finish its reaction: a popup
// only returns when it is closed, so it cannot run inside the program.
#define ATI_POPQ_MAX 8
static struct { AVal h; int x; int y; } ATI_POPQ[ATI_POPQ_MAX];
static int      ATI_POPQ_N = 0;
static Ihandle* ATI_POPT   = NULL;

static int ati_pop_cb (Ihandle* t) {
    if (ATI_TICK) {
        return IUP_DEFAULT;     // not inside the tick, which would stop
    }
    IupSetAttribute(t, "RUN", "NO");
    while (ATI_POPQ_N > 0) {
        AVal h = ATI_POPQ[0].h;
        int  x = ATI_POPQ[0].x;
        int  y = ATI_POPQ[0].y;
        ATI_POPQ_N--;
        memmove(&ATI_POPQ[0], &ATI_POPQ[1], ATI_POPQ_N*sizeof(ATI_POPQ[0]));
        Ihandle* ih = ati_ptr(h);
        if (ih != NULL) {
            ATI_POPS++;
            IupPopup(ih, x, y);
            ATI_POPS--;
            ih = ati_ptr(h);
            if (ih != NULL) {
                ati_fire(ati_evt("popup", ih));
            }
        }
        a_dec(h);
        ati_check();
    }
    return IUP_DEFAULT;
}

static AStatus ati_popup (AVal h, AVal x, AVal y) {
    Ihandle* ih = ati_ptr(h);
    if (ih == NULL) {
        return a_error("invalid handle");
    }
    if (ATI_POPQ_N >= ATI_POPQ_MAX) {
        return a_error("too many popups");
    }
    int def = !strcmp(IupGetClassName(ih), "menu") ? IUP_MOUSEPOS : IUP_CENTERPARENT;
    a_inc(h);
    ATI_POPQ[ATI_POPQ_N].h = h;
    ATI_POPQ[ATI_POPQ_N].x = a_isnum(x) ? (int)a_dbl(x) : def;
    ATI_POPQ[ATI_POPQ_N].y = a_isnum(y) ? (int)a_dbl(y) : def;
    ATI_POPQ_N++;
    IupSetAttribute(ATI_POPT, "RUN", "YES");
    return A_OK;
}

// Draws on a canvas: `op` is `begin`, `end`, `line`, `rectangle`,
// `arc`, or `text`.
static AStatus ati_draw (AVal h, AVal op, AVal a, AVal b, AVal c, AVal d, AVal e, AVal f) {
    Ihandle* ih = ati_ptr(h);
    if (ih == NULL) {
        return a_error("invalid handle");
    }
    if (op.type != A_STR) {
        return a_error("invalid operation : expected string");
    }
    const char* o = A_STR_OF(op)->s;
    int n4 = a_isnum(a) && a_isnum(b) && a_isnum(c) && a_isnum(d);
    if (!strcmp(o, "begin")) {
        IupDrawBegin(ih);
    } else if (!strcmp(o, "end")) {
        IupDrawEnd(ih);
    } else if (!strcmp(o, "line") && n4) {
        IupDrawLine(ih, (int)a_dbl(a), (int)a_dbl(b), (int)a_dbl(c), (int)a_dbl(d));
    } else if (!strcmp(o, "rectangle") && n4) {
        IupDrawRectangle(ih, (int)a_dbl(a), (int)a_dbl(b), (int)a_dbl(c), (int)a_dbl(d));
    } else if (!strcmp(o, "arc") && n4) {
        IupDrawArc(ih, (int)a_dbl(a), (int)a_dbl(b), (int)a_dbl(c), (int)a_dbl(d),
            a_isnum(e) ? a_dbl(e) : 0, a_isnum(f) ? a_dbl(f) : 360);
    } else if (!strcmp(o, "text") && a.type==A_STR && a_isnum(b) && a_isnum(c)) {
        IupDrawText(ih, A_STR_OF(a)->s, 0, (int)a_dbl(b), (int)a_dbl(c), 0, 0);
    } else {
        return a_error("invalid operation : %s", o);
    }
    return A_OK;
}

///////////////////////////////////////////////////////////////////////////////
// TEST MODE
///////////////////////////////////////////////////////////////////////////////

// Lets IUP process what is pending, for some real time.
static void ati_settle (int ms) {
    for (int i=0; i<ms; i+=5) {
        IupFlush();
        usleep(5000);
    }
    IupFlush();
}

// Calls a callback of a control as IUP would, with only the handle.
static int ati_call (Ihandle* h, const char* cb) {
    Icallback f = IupGetCallback(h, cb);
    return (f == NULL) ? IUP_DEFAULT : f(h);
}

// The mouse through the extension XTest of the server, when there is one:
// real events of X, which GTK takes as those of a person. The events
// that IUP synthesizes (`MOUSEBUTTON`) have no device, and a menu of GTK
// ignores them. The library is opened when the program runs, so that the
// environment does not depend on it. `press`: 1 press, 0 release, -1 only
// move, 2 the press of a double click.
static int ati_xtest (int x, int y, int but, int press) {
    typedef int (*FMotion) (void*, int, int, int, unsigned long);
    typedef int (*FButton) (void*, unsigned int, int, unsigned long);
    typedef int (*FFlush)  (void*);
    static int      ok = -1;
    static FMotion  motion;
    static FButton  button;
    static FFlush   flush;
    if (ok == -1) {
        void* xt = dlopen("libXtst.so.6", RTLD_LAZY);
        void* x11 = dlopen("libX11.so.6", RTLD_LAZY);
        motion = xt  ? (FMotion) dlsym(xt, "XTestFakeMotionEvent") : NULL;
        button = xt  ? (FButton) dlsym(xt, "XTestFakeButtonEvent") : NULL;
        flush  = x11 ? (FFlush)  dlsym(x11, "XFlush")              : NULL;
        ok = (motion!=NULL && button!=NULL && flush!=NULL && IupGetGlobal("XDISPLAY")!=NULL);
    }
    if (!ok) {
        return 0;
    }
    void* dpy = (void*) IupGetGlobal("XDISPLAY");
    motion(dpy, -1, x, y, 0);
    flush(dpy);
    ati_settle(20);
    if (press != -1) {
        button(dpy, (unsigned) but, press != 0, 0);
        flush(dpy);
        ati_settle(20);
    }
    return 1;
}

// A press or a release of a button of the mouse at a position of a
// control (its center, by default).
static void ati_mouse (Ihandle* h, const char* pos, int but, int press) {
    int x, y, w, hh, dx, dy;
    IupGetIntInt(h, "SCREENPOSITION", &x, &y);
    IupGetIntInt(h, "RASTERSIZE", &w, &hh);
    if (pos!=NULL && sscanf(pos, "%d,%d", &dx, &dy)==2) {
        x += dx;
        y += dy;
    } else {
        x += w/2;
        y += hh/2;
    }
    if (ati_xtest(x, y, but, press)) {
        return;
    }
    IupSetfAttribute(NULL, "CURSORPOS", "%dx%d", x, y);
    ati_settle(20);
    IupSetfAttribute(NULL, "MOUSEBUTTON", "%dx%d %d %d", x, y, but, press);
    ati_settle(20);
}

// The actions of the script that are due at `ms`.
static void ati_script (const char* s, int ms) {
    while (s!=NULL && *s!='\0') {
        char item[256];
        size_t n = strcspn(s, ";");
        snprintf(item, sizeof(item), "%.*s", (int)n, s);
        s += n + (s[n] == ';');
        char* act = strchr(item, ':');
        if (act==NULL || atoi(item)!=ms) {
            continue;
        }
        act++;
        char* arg = strchr(act, ':');
        if (arg != NULL) {
            *arg++ = '\0';
        }
        if (!strcmp(act, "quit")) {
            ATI_QUIT = 1;
        } else if (!strcmp(act, "shot") && arg!=NULL) {
            char cmd[512];
            snprintf(cmd, sizeof(cmd), "import -window root '%s'", arg);
            ati_settle(50);
            if (system(cmd) != 0) {
                fprintf(stderr, "iup : shot failed : %s\n", arg);
            }
        } else if (arg != NULL) {
            char* val = strchr(arg, ':');
            if (val != NULL) {
                *val++ = '\0';
            }
            Ihandle* h = IupGetHandle(arg);
            if (h == NULL) {
                fprintf(stderr, "iup : no control named %s\n", arg);
            } else if (!strcmp(act, "click")) {
                ati_mouse(h, val, 1, 1);
                ati_mouse(h, val, 1, 0);
            } else if (!strcmp(act, "dclick")) {
                ati_mouse(h, val, 1, 1);
                ati_mouse(h, val, 1, 0);
                ati_mouse(h, val, 1, 2);    // the double click (IUP), or a press
                ati_mouse(h, val, 1, 0);
            } else if (!strcmp(act, "rclick")) {
                ati_mouse(h, val, 3, 1);
                ati_mouse(h, val, 3, 0);
            } else if (!strcmp(act, "move")) {
                ati_mouse(h, val, 1, -1);
            } else if (!strcmp(act, "set") && val!=NULL) {
                char* eq = strchr(val, '=');
                if (eq != NULL) {
                    *eq++ = '\0';
                    IupSetStrAttribute(h, val, eq);
                    ati_call(h, "VALUECHANGED_CB");
                }
            } else if (!strcmp(act, "get") && val!=NULL) {
                const char* v = IupGetAttribute(h, val);
                printf("%s.%s = %s\n", arg, val, (v==NULL) ? "nil" : v);
            } else if (!strcmp(act, "key") && val!=NULL) {
                int c = (strlen(val) == 1) ? (unsigned char)val[0] : (int)strtol(val, NULL, 0);
                if (IupGetFocus() != h) {
                    IupSetFocus(h);     // which selects the text of a field
                    ati_settle(20);
                }
                IupSetInt(NULL, "KEY", c);
                ati_settle(20);
            } else if (!strcmp(act, "act")) {
                ati_call(h, "ACTION");
                Ihandle* m = IupGetParent(h);
                if (m!=NULL && !strcmp(IupGetClassName(m), "menu")) {
                    IupUnmap(m);        // closes the menu of the item
                }
            } else if (!strcmp(act, "close")) {
                if (ati_call(h, "CLOSE_CB") != IUP_IGNORE) {
                    IupHide(h);
                }
            }
        }
    }
}

///////////////////////////////////////////////////////////////////////////////
// DRIVER
///////////////////////////////////////////////////////////////////////////////

// The environment registers itself with `atmos.env` (see the end of this
// file), and the generic `main` of the runtime calls its step. As the
// primary environment, the step waits in the loop of IUP, and a timer
// gives the time to the program. As a secondary one, the step only
// processes what IUP has ready, and gives no time.

static const char* ATI_SCRIPT  = NULL;
static int         ATI_PRIMARY = 1;     // the mode of the environment
static int         ATI_FIRST   = 1;     // the first step is to come
static int         ATI_MS      = 0;     // the virtual time of the script
static int64_t     ATI_PRV     = 0;     // the real time of the last tick
static Ihandle*    ATI_TICKT   = NULL;

static int64_t ati_now (void) {
    struct timespec ts;
    clock_gettime(CLOCK_MONOTONIC, &ts);
    return (int64_t)ts.tv_sec*1000000 + ts.tv_nsec/1000;
}

// The timer that lets the time pass in the program, as the primary
// environment. In the test mode, each tick is 10ms of virtual time,
// after the actions that are due.
static int ati_tick (Ihandle* t) {
    (void) t;
    int64_t us = 0;
    ATI_TICK = 1;
    if (ATI_SCRIPT != NULL) {
        ati_script(ATI_SCRIPT, ATI_MS);
        ATI_MS += 10;
        us = 10000;
    } else {
        int64_t now = ati_now();
        us = now - ATI_PRV;
        ATI_PRV = now;
    }
    // the time in the unit of the build (`A_CLOCK_US` microseconds), with
    // what is left for the next tick
    static int64_t rest = 0;
    rest += us;
    AInt dt = (AInt) (rest / A_CLOCK_US);
    if (ATI_PRIMARY && dt>0 && !ATI_BUSY && !ATI_QUIT) {
        rest -= (int64_t)dt * A_CLOCK_US;
        AVal evt = a_int(dt);
        ati_emit(evt);
        ati_drain();
    } else if (!ATI_PRIMARY) {
        rest = 0;
    }
    ati_check();
    ATI_TICK = 0;
    return IUP_DEFAULT;
}

// Opens IUP, when the file is included: before the program creates its
// controls. The main chunk runs as a reaction: the callbacks that it
// provokes wait in the queue for the first step.
static void ati_open (void) {
    if (IupOpen(NULL, NULL) != IUP_NOERROR) {
        fprintf(stderr, "iup : cannot open the display\n");
        exit(1);
    }
    ATI_SCRIPT  = getenv("IUP_ATM_SCRIPT");
    ATI_BUSY    = 1;

    // the loop ends with the program, not with the last dialog
    IupSetGlobal("LOCKLOOP", "YES");

    ATI_POPT = IupTimer();
    IupSetAttribute(ATI_POPT, "TIME", "1");
    IupSetCallback(ATI_POPT, "ACTION_CB", ati_pop_cb);

    ATI_TICKT = IupTimer();
    IupSetAttribute(ATI_TICKT, "TIME", (ATI_SCRIPT != NULL) ? "1" : "10");
    IupSetCallback(ATI_TICKT, "ACTION_CB", ati_tick);
}

// One step of the loop of IUP. Returns 1 if the program is over.
static int ati_step (int primary) {
    if (ATI_FIRST) {
        ATI_FIRST = 0;
        ATI_PRIMARY = primary;
        if (ATI_SCRIPT != NULL) {
            ati_settle(200);        // the dialogs are on the screen
        }
        ATI_BUSY = 0;
        ati_drain();
        ATI_PRV = ati_now();
        IupSetAttribute(ATI_TICKT, "RUN", "YES");
    }
    if (ATI_ST==A_OK && !ATI_QUIT && atm_alive()) {
        if (ATI_PRIMARY) {
            IupLoopStepWait();
        } else {
            IupLoopStep();
            IupFlush();
        }
    }
    return ATI_QUIT || ATI_ST!=A_OK;
}

static void ati_quit (void) {
    if (ATI_TICKT != NULL) {
        IupSetAttribute(ATI_TICKT, "RUN", "NO");
    }
    for (int i=0; i<ATI_QUEUE_N; i++) {
        a_dec(ATI_QUEUE[i]);
    }
    ATI_QUEUE_N = 0;
    for (int i=0; i<ATI_POPQ_N; i++) {
        a_dec(ATI_POPQ[i].h);
    }
    ATI_POPQ_N = 0;
    fflush(stdout);
    IupClose();
}
```

`ati_open();`

pin iup = [
    ;; iup.new(class, t): a control of the given class
    new = func (cls, t) {
        var h
        `st = ati_new(&$h, $cls, $t);`
        h
    },

    ;; iup.set(h, name, v): sets an attribute
    set = func (h, name, v) {
        `st = ati_set($h, $name, $v);`
    },

    ;; iup.get(h, name): reads an attribute, as a string or nil
    get = func (h, name) {
        var v
        `st = ati_get(&$v, $h, $name);`
        v
    },

    ;; iup.show(h): shows a dialog
    show = func (h) {
        `st = ati_show($h, 1);`
    },

    ;; iup.hide(h): hides a dialog
    hide = func (h) {
        `st = ati_show($h, 0);`
    },

    ;; iup.popup(h, x, y): shows a menu or a dialog, and holds the other
    ;; dialogs until it closes
    popup = func (h, x, y) {
        `st = ati_popup($h, $x, $y);`
    },

    ;; iup.update(h): asks a control to be drawn again
    update = func (h) {
        `st = ati_update($h);`
    },

    ;; iup.draw(h, op, ...): draws on a canvas
    draw = func (h, op, a, b, c, d, e, f) {
        `st = ati_draw($h, $op, $a, $b, $c, $d, $e, $f);`
    },
]

;; The environment: the primary one waits in the loop of IUP and gives
;; the time; a secondary one only processes what IUP has ready.
atmos.env([
    mode = [primary=true, secondary=true],
    step = func (mode) {
        val primary = (mode == :primary)
        var end
        `$end = a_bool(ati_step(a_truthy($primary)));`
        end
    },
    quit = func () {
        `ati_quit();`
    },
])
